# ---------------------------------------------------------------------------
# RecoverOS environment configuration (copy to .env for local development).
# The API validates this at startup and refuses insecure production settings.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Deep-link scheme used in emails/SMS
APP_BASE_URL=recoveros://
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (for correct client IPs behind a load balancer)
TRUST_PROXY=0

# Data stores — MongoDB MUST be a replica set (transactions)
MONGODB_URI=mongodb://localhost:27017/recoveros?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# bullmq (default, requires Redis) | inline (tests / Redis-less dev only; rejected in production)
QUEUE_DRIVER=bullmq
# Run BullMQ workers inside the API process (dev). In production run `npm run start:worker` separately.
RUN_WORKERS_IN_API=true

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ISSUER=recoveros-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Signs expiring document download links (required in production)
FILE_URL_SIGNING_SECRET=

# CORS — comma separated (native mobile apps send no Origin and are unaffected)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Google Gemini (server-side only — never put this in the mobile app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Private object storage — s3 (AWS S3 / MinIO / R2) or local (development only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=recoveros-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# Email (unset SMTP_HOST → messages are logged in development, refused in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RecoverOS <no-reply@recoveros.local>

# SMS: console | termii | africastalking | twilio
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=RecoverOS

# WhatsApp Business Cloud API (optional)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Push notifications (Expo push service by default)
PUSH_NOTIFICATION_CONFIG={"provider":"expo"}

# Billing: manual | paystack | flutterwave
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# API docs at /api/docs
ENABLE_SWAGGER=true
# Development only: include one-time codes/tokens in API responses (forced off in production)
DEV_EXPOSE_OTP=true

# ---------------------------------------------------------------------------
# Mobile app (apps/mobile) — public values only, read at build time
# ---------------------------------------------------------------------------
# Android emulator reaches the host at 10.0.2.2; a physical device needs your LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
